<Project Sdk="Microsoft.NET.Sdk.Web">

  <ItemGroup>
    <ProjectReference Include="..\GoCheaper.ServiceDefaults\GoCheaper.ServiceDefaults.csproj" />
    <ProjectReference Include="..\GoCheaper.Contracts\GoCheaper.Contracts.csproj" />
  </ItemGroup>

  <ItemGroup>
    <PackageReference Include="Aspire.Confluent.Kafka" Version="13.4.6" />
<PackageReference Include="MailKit" Version="4.17.0" />
  </ItemGroup>

  <ItemGroup>
    <!-- WithCulture=false prevents MSBuild from treating files like AuthCodeEmail.da.html
         as satellite assembly resources (it would otherwise put them in da/*.resources.dll,
         making GetManifestResourceStream on the main assembly return null). -->
    <EmbeddedResource Include="Templates\*.html">
      <WithCulture>false</WithCulture>
    </EmbeddedResource>
  </ItemGroup>

  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <UserSecretsId>667dc2ba-f011-4075-bf9c-2e460c9d3687</UserSecretsId>
    <Configurations>Debug;Release;AzureTest</Configurations>
  </PropertyGroup>

</Project>
