  <data name="Home_Step2_Title" xml:space="preserve"><value>Passenger books a seat</value></data>
  <data name="Home_Step2_Desc" xml:space="preserve"><value>Browse available trips, pick one that fits, and book in seconds. Both driver and passenger receive an email confirmation.</value></data>
