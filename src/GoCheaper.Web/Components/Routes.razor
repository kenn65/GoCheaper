@using GoCheaper.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using System.Globalization
@inject UserSession UserSession
@inject NavigationManager Nav
@inject PersistentComponentState ApplicationState
@inject CultureContext CultureCtx
@inject IJSRuntime JS
@implements IDisposable

<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    private PersistingComponentStateSubscription _cultureSub;

    protected override async Task OnInitializedAsync()
    {
        // Routes.razor IS the interactive component, so its RegisterOnPersisting callback
        // reliably fires during SSR when the component transitions to interactive mode.
        // App.razor is SSR-only and its PersistCulture never fires — only this component's does.
        _cultureSub = ApplicationState.RegisterOnPersisting(PersistCulture);

        // Restore culture this component persisted during SSR phase.
        if (ApplicationState.TryTakeFromJson<string>("routes-culture", out var saved)
            && !string.IsNullOrEmpty(saved))
        {
            ApplyCulture(saved);
        }

        Nav.LocationChanged += OnLocationChanged;

        if (AuthState is not null)
        {
            var state = await AuthState;
            UserSession.LoadFromClaims(state.User);
            RedirectIfIncomplete(Nav.Uri);
        }
    }

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        // Safety net: if OnInitializedAsync didn't set the culture (PersistentComponentState
        // didn't transfer), read it from the browser — the AspNetCore.Culture cookie (not
        // HttpOnly) and navigator.language are both accessible from JS.
        if (CultureCtx.Culture != "en") return;

        try
        {
            var lang = await JS.InvokeAsync<string>("eval",
                "(function(){" +
                "var c=document.cookie.split(';').map(function(s){return s.trim();}).find(function(s){return s.startsWith('.AspNetCore.Culture=');});" +
                "if(c){var v=decodeURIComponent(c.substring('.AspNetCore.Culture='.length));var m=v.match(/uic=([^|]+)/);if(m)return m[1];}" +
                "return navigator.language||'';" +
                "})()");

            if (!string.IsNullOrEmpty(lang) && lang != "en")
            {
                var culture = lang.StartsWith("da") ? "da"
                    : (lang.StartsWith("nb") || lang.StartsWith("no")) ? "nb"
                    : lang.StartsWith("sv") ? "sv"
                    : null;

                if (culture != null)
                    ApplyCulture(culture);
            }
        }
        catch (JSException) { }
        catch (JSDisconnectedException) { }
    }

    // Fires during SSR phase when rendering is serialized for the circuit transition.
    private Task PersistCulture()
    {
        ApplicationState.PersistAsJson("routes-culture", CultureInfo.CurrentUICulture.Name);
        return Task.CompletedTask;
    }

    private void ApplyCulture(string cultureName)
    {
        try
        {
            var ci = CultureInfo.GetCultureInfo(cultureName);
            CultureInfo.CurrentCulture   = ci;
            CultureInfo.CurrentUICulture = ci;
            CultureCtx.Culture = cultureName;
        }
        catch (CultureNotFoundException) { }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => RedirectIfIncomplete(e.Location);

    private void RedirectIfIncomplete(string uri)
    {
        if (!UserSession.IsLoggedIn || UserSession.IsProfileComplete) return;
        var path = new Uri(uri).AbsolutePath.TrimStart('/');
        if (path != "complete-profile")
            Nav.NavigateTo("/complete-profile");
    }

    public void Dispose()
    {
        _cultureSub.Dispose();
        Nav.LocationChanged -= OnLocationChanged;
    }
}
