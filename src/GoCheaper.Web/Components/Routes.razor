@using GoCheaper.Web.Services
@using Microsoft.AspNetCore.Components.Authorization
@using Microsoft.AspNetCore.Localization
@using System.Globalization
@inject UserSession UserSession
@inject NavigationManager Nav
@inject PersistentComponentState ApplicationState
@inject CultureContext CultureCtx
@inject IHttpContextAccessor HttpContextAccessor
@implements IDisposable

<Router AppAssembly="typeof(Program).Assembly" NotFoundPage="typeof(Pages.NotFound)">
    <Found Context="routeData">
        <AuthorizeRouteView RouteData="routeData" DefaultLayout="typeof(Layout.MainLayout)">
            <NotAuthorized>
                <RedirectToLogin />
            </NotAuthorized>
        </AuthorizeRouteView>
        <FocusOnNavigate RouteData="routeData" Selector="h1" />
    </Found>
</Router>

@code {
    [CascadingParameter] private Task<AuthenticationState>? AuthState { get; set; }

    protected override async Task OnInitializedAsync()
    {
        // Primary: read the culture that RequestLocalizationMiddleware resolved for the
        // original HTTP request. IHttpContextAccessor.HttpContext in Blazor Server holds
        // that initial request context for the lifetime of the circuit, so this is
        // reliable regardless of whether PersistentComponentState transfers correctly.
        var resolvedCulture = HttpContextAccessor.HttpContext
            ?.Features.Get<IRequestCultureFeature>()
            ?.RequestCulture.UICulture.Name;

        // Fallback: PersistentComponentState written by App.razor.PersistCulture during SSR.
        if (string.IsNullOrEmpty(resolvedCulture) || resolvedCulture == "en")
        {
            if (ApplicationState.TryTakeFromJson<string>("culture", out var saved)
                && !string.IsNullOrEmpty(saved))
            {
                resolvedCulture = saved;
            }
        }
        else
        {
            // Still consume the key so it doesn't linger in PersistentComponentState.
            ApplicationState.TryTakeFromJson<string>("culture", out _);
        }

        if (!string.IsNullOrEmpty(resolvedCulture))
        {
            var ci = CultureInfo.GetCultureInfo(resolvedCulture);
            CultureInfo.CurrentCulture   = ci;
            CultureInfo.CurrentUICulture = ci;
            CultureCtx.Culture = resolvedCulture;
        }

        Nav.LocationChanged += OnLocationChanged;

        if (AuthState is not null)
        {
            var state = await AuthState;
            UserSession.LoadFromClaims(state.User);
            RedirectIfIncomplete(Nav.Uri);
        }
    }

    private void OnLocationChanged(object? sender, LocationChangedEventArgs e)
        => RedirectIfIncomplete(e.Location);

    private void RedirectIfIncomplete(string uri)
    {
        if (!UserSession.IsLoggedIn || UserSession.IsProfileComplete) return;
        var path = new Uri(uri).AbsolutePath.TrimStart('/');
        if (path != "complete-profile")
            Nav.NavigateTo("/complete-profile");
    }

    public void Dispose()
        => Nav.LocationChanged -= OnLocationChanged;
}
