@page "/verify-email"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@using GoCheaper.Web.Services
@inject IdentityApiClient IdentityApi
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

<PageTitle>Verify Email - GoCheaper</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm text-center">
                <div class="card-body py-5 px-4">

                    @if (isLoading)
                    {
                        <div class="spinner-border text-primary mb-3" role="status"></div>
                        <p class="text-muted">@L["VerifyEmail_Verifying"]</p>
                    }
                    else if (result is not null && result.Success)
                    {
                        <div class="mb-3 text-success" style="font-size: 3rem;">&#10003;</div>
                        <h4 class="text-success">@L["VerifyEmail_Success_Title"]</h4>
                        <p class="text-muted">
                            @if (result.FirstName is not null)
                            {
                                <span>@string.Format(L["VerifyEmail_Hi"], result.FirstName) </span>
                            }
                            else
                            {
                                <span>@L["VerifyEmail_Your"] </span>
                            }
                            @L["VerifyEmail_Success_Confirmed"]
                        </p>
                        <p class="text-muted small">@string.Format(L["VerifyEmail_Redirecting"], countdown)</p>
                    }
                    else if (result is not null && !result.Success)
                    {
                        <div class="mb-3 text-danger" style="font-size: 3rem;">&#x26A0;</div>
                        <h4 class="text-danger">@L["VerifyEmail_Failed_Title"]</h4>
                        <p class="text-muted">@result.Error</p>
                        <p class="small text-muted">@L["VerifyEmail_Failed_Msg"]</p>
                    }
                    else if (linkInvalid)
                    {
                        <div class="mb-3 text-warning" style="font-size: 3rem;">&#x26A0;</div>
                        <h4>@L["VerifyEmail_Invalid_Title"]</h4>
                        <p class="text-muted">@L["VerifyEmail_Invalid_Msg"]</p>
                    }

                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "userId")] public string? UserId { get; set; }
    [SupplyParameterFromQuery(Name = "token")]  public string? Token  { get; set; }

    private VerifyEmailResult? result;
    private bool isLoading = true;
    private bool linkInvalid;
    private int countdown = 3;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        if (!Guid.TryParse(UserId, out var userId) || string.IsNullOrWhiteSpace(Token))
        {
            linkInvalid = true;
            isLoading   = false;
            StateHasChanged();
            return;
        }

        result    = await IdentityApi.VerifyEmailAsync(userId, Token);
        isLoading = false;
        StateHasChanged();

        if (result.Success)
        {
            while (countdown > 0)
            {
                await Task.Delay(1000);
                countdown--;
                StateHasChanged();
            }
            Nav.NavigateTo("/login");
        }
    }
}
