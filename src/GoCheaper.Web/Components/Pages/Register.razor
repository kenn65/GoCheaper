@page "/register"
@rendermode InteractiveServer
@using GoCheaper.Web.Models
@using GoCheaper.Web.Services
@inject IdentityApiClient IdentityApi
@inject IWebHostEnvironment Env
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

<PageTitle>Register - GoCheaper</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">

            @if (registrationResult is not null)
            {
                <div class="card border-success shadow-sm">
                    <div class="card-body text-center py-5">
                        <div class="mb-3">
                            <span style="font-size: 3rem;">&#10003;</span>
                        </div>
                        <h4 class="text-success">@L["Register_Success_Title"]</h4>
                        <p class="mb-1">@L["Register_Success_Welcome"]</p>
                        <p class="text-muted small mb-3">
                            @string.Format(L["Register_Success_Check"], registrationResult.Email)
                        </p>
                        @if (Env.IsDevelopment() && registrationResult.EmailVerificationToken is not null)
                        {
                            <div class="alert alert-warning text-start small">
                                <strong>Dev only &mdash; verification token:</strong><br />
                                <code class="user-select-all">@registrationResult.EmailVerificationToken</code>
                            </div>
                        }
                        <p class="text-muted small">@string.Format(L["Register_Redirecting"], _countdown)</p>
                    </div>
                </div>
            }
            else
            {
                <div class="card shadow-sm">
                    <div class="card-header bg-primary text-white py-3">
                        <h4 class="mb-0">@L["Register_Title"]</h4>
                        <small class="opacity-75">@L["Register_Subtitle"]</small>
                    </div>
                    <div class="card-body p-4">

                        @if (!string.IsNullOrEmpty(apiError))
                        {
                            <div class="alert alert-danger">@apiError</div>
                        }

                        <EditForm Model="model" OnValidSubmit="HandleSubmit">
                            <DataAnnotationsValidator />

                            <div class="mb-3">
                                <label class="form-label">@L["Register_Email"]</label>
                                <InputText @bind-Value="model.Email" type="email" class="form-control"
                                           placeholder="@L["Register_Email"]" autocomplete="email" />
                                <ValidationMessage For="() => model.Email" class="text-danger small" />
                            </div>

                            <div class="mb-3">
                                <label class="form-label">@L["Register_Password"]</label>
                                <InputText @bind-Value="model.Password" class="form-control" type="password"
                                           placeholder="@L["Register_PasswordHint"]" autocomplete="new-password" />
                                <ValidationMessage For="() => model.Password" class="text-danger small" />
                            </div>

                            <div class="mb-4">
                                <label class="form-label">@L["Register_ConfirmPassword"]</label>
                                <InputText @bind-Value="model.ConfirmPassword" class="form-control" type="password"
                                           placeholder="@L["Register_ConfirmHint"]" autocomplete="new-password" />
                                <ValidationMessage For="() => model.ConfirmPassword" class="text-danger small" />
                            </div>

                            <hr />

                            <div class="mb-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="chkPrivacy"
                                           checked="@model.AgreeToPrivacyPolicy"
                                           @onchange="e => model.AgreeToPrivacyPolicy = (bool)e.Value!" />
                                    <label class="form-check-label" for="chkPrivacy">
                                        @L["Register_PrivacyAgree"]
                                        <a href="/privacy-policy" target="_blank">@L["Register_PrivacyPolicy"]</a>
                                    </label>
                                </div>
                                @if (privacyError is not null)
                                {
                                    <div class="text-danger small mt-1">@privacyError</div>
                                }
                            </div>

                            <button type="submit" class="btn btn-primary btn-lg w-100" disabled="@isLoading">
                                @if (isLoading)
                                {
                                    <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                    <span>@L["Register_Creating"]</span>
                                }
                                else
                                {
                                    <span>@L["Register_Create"]</span>
                                }
                            </button>
                        </EditForm>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

@code {
    private readonly RegisterModel model = new();
    private RegisterResponse? registrationResult;
    private string? apiError;
    private string? privacyError;
    private bool isLoading;
    private int _countdown = 3;

    private async Task HandleSubmit()
    {
        apiError     = null;
        privacyError = null;

        if (!model.AgreeToPrivacyPolicy)
        {
            privacyError = L["Register_MustAgreePrivacy"];
            return;
        }

        isLoading = true;
        try
        {
            var result = await IdentityApi.RegisterAsync(model);
            if (result.Success)
            {
                registrationResult = result.User;
                isLoading = false;
                StateHasChanged();
                while (_countdown > 0)
                {
                    await Task.Delay(1000);
                    _countdown--;
                    StateHasChanged();
                }
                Nav.NavigateTo("/");
                return;
            }
            else
            {
                apiError = result.Error ?? "Registration failed. Please try again.";
            }
        }
        catch (Exception)
        {
            apiError = "Could not reach the server. Please try again.";
        }
        finally
        {
            isLoading = false;
        }
    }
}
