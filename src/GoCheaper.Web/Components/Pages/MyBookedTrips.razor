@page "/my-booked-trips"
@rendermode InteractiveServer
@attribute [Authorize]
@using GoCheaper.Web.Services
@inject BookingApiClient BookingClient
@inject IStringLocalizer<SharedResources> L

<PageTitle>My Booked Trips - GoCheaper</PageTitle>

<div class="container py-4">
    @if (_loading)
    {
        <div class="text-center py-5">
            <div class="spinner-border text-primary" role="status"></div>
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0">@L["MyBookedTrips_Title"]</h4>
            </div>
            <div class="card-body">
                @if (_error is not null)
                {
                    <div class="alert alert-danger">@_error</div>
                }
                else if (_bookings is { Count: 0 })
                {
                    <div class="alert alert-info">
                        @L["MyBookedTrips_NoBookings"] <a href="/browse-trips">@L["MyBookedTrips_BrowseLink"]</a>.
                    </div>
                }
                else
                {
        <!-- Mobile cards -->
        <div class="d-md-none">
            @foreach (var b in _bookings!)
            {
                <div class="card mb-3 shadow-sm">
                    <div class="card-body">
                        <div class="d-flex justify-content-between align-items-start mb-2">
                            <div>
                                <div class="fw-semibold">@b.From &rarr; @b.To</div>
                                <small class="text-muted">@(b.DepartureTime?.ToString("dd MMM yyyy HH:mm") ?? "—")</small>
                                <div class="small mt-1">@L["MyBookedTrips_Driver"] <a href="/driver/@b.DriverId">@b.DriverFullName</a></div>
                                <div class="mt-1">
                                    <span class="badge @TripStatus.BadgeClass(b.DepartureTime)">@L["Status_" + TripStatus.Compute(b.DepartureTime)]</span>
                                </div>
                            </div>
                            <a href="/passenger/trips/@b.TripId" class="btn btn-sm btn-outline-primary ms-2 flex-shrink-0">@L["MyBookedTrips_Details"]</a>
                        </div>
                        <div class="row row-cols-2 g-1 small">
                            <div class="col text-muted">@L["MyBookedTrips_Price"] <span class="text-body fw-semibold">@b.PricePerSeat.ToString("N2") @b.Currency</span></div>
                            <div class="col text-muted">@L["MyBookedTrips_Seats"] <span class="text-body fw-semibold">@b.SeatsCount</span></div>
                        </div>
                    </div>
                </div>
            }
        </div>

        <!-- Desktop table -->
        <div class="d-none d-md-block">
            <div class="table-responsive">
                <table class="table table-hover align-middle">
                    <thead class="table-light">
                        <tr>
                            <th>@L["MyBookedTrips_Driver_Header"]</th>
                            <th>@L["MyBookedTrips_From"]</th>
                            <th>@L["MyBookedTrips_To"]</th>
                            <th>@L["MyBookedTrips_Departure"]</th>
                            <th>@L["MyBookedTrips_Status"]</th>
                            <th>@L["MyBookedTrips_PricePerSeat"]</th>
                            <th>@L["MyBookedTrips_Seats_Header"]</th>
                            <th></th>
                        </tr>
                    </thead>
                    <tbody>
                        @foreach (var b in _bookings!)
                        {
                            <tr>
                                <td><a href="/driver/@b.DriverId">@b.DriverFullName</a></td>
                                <td>@b.From</td>
                                <td>@b.To</td>
                                <td>@(b.DepartureTime?.ToString("dd MMM yyyy HH:mm") ?? "—")</td>
                                <td><span class="badge @TripStatus.BadgeClass(b.DepartureTime)">@L["Status_" + TripStatus.Compute(b.DepartureTime)]</span></td>
                                <td>@b.PricePerSeat.ToString("N2") @b.Currency</td>
                                <td>@b.SeatsCount</td>
                                <td>
                                    <a href="/passenger/trips/@b.TripId" class="btn btn-sm btn-outline-primary">@L["MyBookedTrips_Details"]</a>
                                </td>
                            </tr>
                        }
                    </tbody>
                </table>
            </div>
        </div>
                }
            </div>
        </div>
    }
</div>

@code {
    private List<PassengerBookingResponse>? _bookings;
    private bool    _loading = true;
    private string? _error;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var result = await BookingClient.GetMyBookingsAsync();
        if (result.Success)
            _bookings = result.Bookings ?? [];
        else
            _error = result.Error;
        _loading = false;
        StateHasChanged();
    }
}
