@page "/my-profile"
@rendermode @(new InteractiveServerRenderMode(prerender: false))
@attribute [Authorize]
@using GoCheaper.Web.Models
@using GoCheaper.Web.Services
@inject IdentityApiClient IdentityApi
@inject AuthCookieService AuthCookies
@inject UserSession UserSession
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

<PageTitle>My Profile - GoCheaper</PageTitle>

<div class="container py-3 py-md-5">
    <div class="row justify-content-center">
        <div class="col-12 col-md-8 col-lg-7">

            @if (isLoading)
            {
                <div class="text-center py-5">
                    <div class="spinner-border text-primary" role="status"></div>
                </div>
            }
            else if (apiError is not null)
            {
                <div class="alert alert-danger">@apiError</div>
            }
            else if (user is not null)
            {
                @if (saveError is not null)
                {
                    <div class="alert alert-danger alert-dismissible">
                        @saveError
                        <button type="button" class="btn-close" @onclick="() => saveError = null"></button>
                    </div>
                }

                <div class="card shadow-sm mb-4">
                    <div class="card-header bg-primary text-white py-3">
                        <h4 class="mb-0">@L["MyProfile_Title"]</h4>
                    </div>
                    <div class="card-body p-4">

                        <div class="d-flex gap-3 align-items-center mb-4">
                            <div class="flex-shrink-0">
                                @if (!string.IsNullOrEmpty(user.DriverPictureBase64))
                                {
                                    <img src="@ImageDataUrl(user.DriverPictureBase64)"
                                         class="rounded-circle border"
                                         style="width:80px;height:80px;object-fit:cover;"
                                         alt="Profile picture" />
                                }
                                else
                                {
                                    <div class="rounded-circle border bg-secondary d-flex align-items-center
                                                justify-content-center text-white fw-bold fs-2"
                                         style="width:80px;height:80px;">
                                        @(string.IsNullOrEmpty(user.FirstName) ? "?" : user.FirstName[0].ToString())
                                    </div>
                                }
                            </div>
                            <div style="min-width:0;overflow:hidden" class="flex-grow-1">
                                <h5 class="mb-1 fw-semibold text-truncate">@user.FirstName @user.LastName</h5>
                                <div class="mb-1">
                                    <span class="text-muted small d-block" style="word-break:break-all;overflow-wrap:break-word">@user.Email</span>
                                    @if (user.IsEmailVerified)
                                    {
                                        <span class="badge bg-success mt-1">@L["MyProfile_Verified"]</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-warning text-dark mt-1">@L["MyProfile_Unverified"]</span>
                                    }
                                </div>
                                <div class="text-muted small text-truncate">@string.Format(L["MyProfile_MemberSince"], user.CreatedAt.ToString("d MMMM yyyy"))</div>
                            </div>
                        </div>

                        <h6 class="text-muted text-uppercase small fw-semibold mb-2">@L["MyProfile_AccountInfo"]</h6>
                        <div class="mb-4">
                            <div class="mb-2">
                                <div class="small text-muted">@L["MyProfile_MobilePhone"]</div>
                                <div>@(string.IsNullOrEmpty(user.MobilePhone) ? "—" : user.MobilePhone)</div>
                            </div>
                            <div class="mb-2">
                                <div class="small text-muted">@L["MyProfile_AccountType"]</div>
                                <div>
                                    @if (user.IsDriver && user.IsPassenger)   { <span>@L["MyProfile_DriverAndPassenger"]</span> }
                                    else if (user.IsDriver)                    { <span>@L["MyProfile_Driver"]</span> }
                                    else if (user.IsPassenger)                 { <span>@L["MyProfile_Passenger"]</span> }
                                </div>
                            </div>
                        </div>

                        <hr />

                        <h6 class="text-muted text-uppercase small fw-semibold mb-3">@L["MyProfile_EditProfile"]</h6>

                        <div class="mb-3">
                            <label class="form-label">
                                @L["MyProfile_MobilePhone"]
                                @if (model.IsDriver == true)
                                {
                                    <span class="text-danger"> *</span>
                                }
                                else
                                {
                                    <span class="text-muted small fw-normal"> @L["MyProfile_MobilePhone_Optional"]</span>
                                }
                            </label>
                            <input @bind="model.MobilePhone" class="form-control"
                                   placeholder="+45 12 34 56 78" type="tel" />
                            @if (mobileError is not null)
                            {
                                <div class="text-danger small mt-1">@mobileError</div>
                            }
                        </div>

                        <div class="mb-4">
                            <label class="form-label d-block">@L["MyProfile_AccountType"]</label>
                            <div class="d-flex flex-column flex-sm-row gap-2 gap-sm-4">
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="chkDriver"
                                           checked="@(model.IsDriver == true)"
                                           @onchange="e => model.IsDriver = (bool)e.Value!" />
                                    <label class="form-check-label" for="chkDriver">
                                        <strong>@L["MyProfile_Driver"]</strong> — @L["MyProfile_DriverOffer"]
                                    </label>
                                </div>
                                <div class="form-check">
                                    <input class="form-check-input" type="checkbox" id="chkPassenger"
                                           checked="@(model.IsPassenger == true)"
                                           @onchange="e => model.IsPassenger = (bool)e.Value!" />
                                    <label class="form-check-label" for="chkPassenger">
                                        <strong>@L["MyProfile_Passenger"]</strong> — @L["MyProfile_PassengerBook"]
                                    </label>
                                </div>
                            </div>
                            @if (roleError is not null)
                            {
                                <div class="text-danger small mt-1">@roleError</div>
                            }
                        </div>

                        <div class="mb-4">
                            <label class="form-label">
                                @L["MyProfile_ProfilePicture"]
                                @if (model.IsDriver != true)
                                {
                                    <span class="text-muted small fw-normal"> @L["MyProfile_ProfilePicture_Optional"]</span>
                                }
                            </label>

                            @{
                                var previewBase64 = model.DriverPictureBase64 ?? user.DriverPictureBase64;
                            }
                            @if (!string.IsNullOrEmpty(previewBase64))
                            {
                                <div class="mb-2">
                                    <img src="@ImageDataUrl(previewBase64)"
                                         class="rounded border"
                                         style="max-height:140px;max-width:100%;object-fit:contain;"
                                         alt="Profile picture" />
                                </div>
                            }

                            <InputFile OnChange="HandleImageUpload" accept="image/*" class="form-control" />
                            @if (!string.IsNullOrEmpty(pictureFileName))
                            {
                                <div class="text-success small mt-1">&#10003; @string.Format(L["MyProfile_PictureSelected"], pictureFileName)</div>
                            }
                            @if (pictureError is not null)
                            {
                                <div class="text-danger small mt-1">@pictureError</div>
                            }
                            <div class="form-text">@L["MyProfile_ImageHint"]</div>
                        </div>

                        <button class="btn btn-primary" @onclick="HandleSave" disabled="@isSaving">
                            @if (isSaving)
                            {
                                <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                                <span>@L["MyProfile_Saving"]</span>
                            }
                            else
                            {
                                <span>@L["MyProfile_SaveChanges"]</span>
                            }
                        </button>
                    </div>
                </div>

                <div class="card shadow-sm mb-4">
                    <div class="card-header py-3">
                        <h4 class="mb-0">@L["MyProfile_YourData"]</h4>
                    </div>
                    <div class="card-body">
                        <p class="text-muted mb-3">@L["MyProfile_YourData_Desc"]</p>
                        <a href="/my-data" class="btn btn-outline-primary btn-sm">@L["MyProfile_ExportData"]</a>
                    </div>
                </div>

                <div class="card border-danger shadow-sm">
                    <div class="card-header bg-danger text-white py-3">
                        <h4 class="mb-0">@L["MyProfile_DangerZone"]</h4>
                    </div>
                    <div class="card-body p-4">
                        <p class="text-muted mb-3">@L["MyProfile_Delete_Desc"]</p>
                        <button class="btn btn-outline-danger" @onclick="() => confirmDelete = true">
                            @L["MyProfile_DeleteBtn"]
                        </button>
                    </div>
                </div>
            }
        </div>
    </div>
</div>

<NotificationModal Show="saveSuccess"
                   Title="@L["MyProfile_SaveSuccess_Title"]"
                   Message="@L["MyProfile_SaveSuccess_Msg"]"
                   OnClose="() => saveSuccess = false" />

<ConfirmModal Show="confirmDelete"
              Title="@L["MyProfile_Delete_Title"]"
              ConfirmLabel="@(isDeleting ? L["MyProfile_Deleting"].Value : "OK")"
              CancelLabel="@L["TripDetails_Cancel"]"
              ConfirmDisabled="@(isDeleting || deleteConfirmText != "DELETE")"
              OnConfirm="HandleDeleteAccount"
              OnCancel="CancelDelete">
    <p class="text-muted mb-3">@L["MyProfile_Delete_Confirm"]</p>
    <label class="form-label small fw-semibold">@L["MyProfile_TypeDelete"]</label>
    <input class="form-control" @bind="deleteConfirmText" placeholder="DELETE" maxlength="10" />
    @if (deleteError is not null)
    {
        <div class="text-danger small mt-2">@deleteError</div>
    }
</ConfirmModal>

@code {
    private RegisterResponse? user;
    private UpdateProfileModel model = new();
    private bool isLoading = true;
    private bool isSaving;
    private bool saveSuccess;
    private string? apiError;
    private string? saveError;
    private string? roleError;
    private string? mobileError;
    private string? pictureError;
    private string pictureFileName = string.Empty;

    private bool    confirmDelete;
    private bool    isDeleting;
    private string  deleteConfirmText = string.Empty;
    private string? deleteError;

    protected override async Task OnAfterRenderAsync(bool firstRender)
    {
        if (!firstRender) return;

        var result = await IdentityApi.GetUserAsync(UserSession.UserId!.Value);
        if (result.Success && result.User is not null)
        {
            user  = result.User;
            model = new UpdateProfileModel
            {
                MobilePhone = user.MobilePhone,
                IsDriver    = user.IsDriver,
                IsPassenger = user.IsPassenger
            };
        }
        else
        {
            apiError = result.Error ?? "Failed to load profile.";
        }

        isLoading = false;
        StateHasChanged();
    }

    private async Task HandleImageUpload(InputFileChangeEventArgs e)
    {
        pictureError              = null;
        pictureFileName           = string.Empty;
        model.DriverPictureBase64 = null;

        if (e.File.Size > 5 * 1024 * 1024)
        {
            pictureError = L["MyProfile_ImageTooLarge"];
            return;
        }

        try
        {
            using var stream = e.File.OpenReadStream(maxAllowedSize: 5 * 1024 * 1024);
            using var ms     = new MemoryStream();
            await stream.CopyToAsync(ms);
            model.DriverPictureBase64 = Convert.ToBase64String(ms.ToArray());
            pictureFileName           = e.File.Name;
        }
        catch
        {
            pictureError = L["MyProfile_ImageReadError"];
        }
    }

    private async Task HandleSave()
    {
        roleError    = null;
        mobileError  = null;
        pictureError = null;
        saveError    = null;
        saveSuccess  = false;

        if (model.IsDriver == false && model.IsPassenger == false)
        {
            roleError = L["MyProfile_RoleError"];
            return;
        }

        if (model.IsDriver == true && string.IsNullOrWhiteSpace(model.MobilePhone))
        {
            mobileError = L["MyProfile_MobileRequired"];
            return;
        }

        if (model.IsDriver == true && string.IsNullOrEmpty(model.DriverPictureBase64) && string.IsNullOrEmpty(user?.DriverPictureBase64))
        {
            pictureError = L["MyProfile_PictureRequired"];
            return;
        }

        isSaving = true;
        try
        {
            var result = await IdentityApi.UpdateProfileAsync(UserSession.UserId!.Value, model);
            if (result.Success && result.User is not null)
            {
                user            = result.User;
                saveSuccess     = true;
                pictureFileName = string.Empty;
                await AuthCookies.UpdateRolesAsync(result.User.IsDriver, result.User.IsPassenger);
            }
            else
            {
                saveError = result.Error ?? "Update failed. Please try again.";
            }
        }
        finally
        {
            isSaving = false;
        }
    }

    private void CancelDelete()
    {
        confirmDelete     = false;
        deleteConfirmText = string.Empty;
        deleteError       = null;
    }

    private async Task HandleDeleteAccount()
    {
        isDeleting  = true;
        deleteError = null;

        var result = await IdentityApi.DeleteAccountAsync(UserSession.UserId!.Value);
        if (result.Success)
        {
            await AuthCookies.SignOutAsync();
            Nav.NavigateTo("/", forceLoad: true);
        }
        else
        {
            deleteError = result.Error ?? "Could not delete account. Please try again.";
        }

        isDeleting = false;
    }

    private static string ImageDataUrl(string base64)
    {
        var mime = base64.StartsWith("/9j/")   ? "image/jpeg"
                 : base64.StartsWith("iVBOR")  ? "image/png"
                 : base64.StartsWith("R0lGOD") ? "image/gif"
                 : "image/jpeg";
        return $"data:{mime};base64,{base64}";
    }
}
