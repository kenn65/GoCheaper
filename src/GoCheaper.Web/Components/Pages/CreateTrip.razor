@page "/trips/create"
@rendermode InteractiveServer
@attribute [Authorize]
@using GoCheaper.Web.Services
@using System.ComponentModel.DataAnnotations
@inject TripsApiClient TripsClient
@inject UserSession UserSession
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

<PageTitle>Create Trip - GoCheaper</PageTitle>

<div class="container py-4" style="max-width:700px">
    @if (!UserSession.IsDriver)
    {
        <div class="alert alert-warning">
            @L["CreateTrip_DriverOnly"]
            <a href="/my-profile" class="alert-link">@L["CreateTrip_UpdateProfile"]</a> @L["CreateTrip_DriverOnlyTo"]
        </div>
    }
    else
    {
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-primary text-white py-3">
                <h4 class="mb-0">@L["CreateTrip_Title"]</h4>
            </div>
            <div class="card-body p-4">
        <EditForm Model="_model" OnValidSubmit="HandleSubmit">
            <DataAnnotationsValidator />

            <div class="mb-3">
                <label class="form-label fw-semibold">@L["CreateTrip_From"]</label>
                <InputText class="form-control" @bind-Value="_model.From" placeholder="@L["CreateTrip_FromHint"]" />
                <ValidationMessage For="() => _model.From" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">@L["CreateTrip_To"]</label>
                <InputText class="form-control" @bind-Value="_model.To" placeholder="@L["CreateTrip_ToHint"]" />
                <ValidationMessage For="() => _model.To" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">@L["CreateTrip_TotalSeats"]</label>
                <InputNumber class="form-control" @bind-Value="_model.TotalSeats" />
                <ValidationMessage For="() => _model.TotalSeats" />
            </div>

            <div class="row mb-3">
                <div class="col-md-4">
                    <label class="form-label fw-semibold">@L["CreateTrip_Currency"]</label>
                    <InputSelect class="form-select" @bind-Value="_model.Currency">
                        <option value="DKK">DKK – Danish Krone</option>
                        <option value="NOK">NOK – Norwegian Krone</option>
                        <option value="SEK">SEK – Swedish Krona</option>
                    </InputSelect>
                </div>
                <div class="col-md-8">
                    <label class="form-label fw-semibold">@string.Format(L["CreateTrip_PricePerSeat"], _model.Currency)</label>
                    <InputNumber class="form-control" @bind-Value="_model.PricePerSeat" />
                    <ValidationMessage For="() => _model.PricePerSeat" />
                </div>
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">@L["CreateTrip_Departure"]</label>
                <InputDate Type="InputDateType.DateTimeLocal" class="form-control" @bind-Value="_model.DepartureTime" />
                <ValidationMessage For="() => _model.DepartureTime" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">@L["CreateTrip_NumberPlate"]</label>
                <InputText class="form-control" @bind-Value="_model.NumberPlate" placeholder="AB 12 345" />
                <ValidationMessage For="() => _model.NumberPlate" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">@L["CreateTrip_Note"]</label>
                <InputTextArea class="form-control" @bind-Value="_model.Note" rows="3"
                               placeholder="@L["CreateTrip_NoteHint"]" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">@L["CreateTrip_PaymentMethod"]</label>
                <InputText class="form-control" @bind-Value="_model.PaymentMethod"
                           placeholder="@L["CreateTrip_PaymentHint"]" />
            </div>

            <div class="mb-3">
                <label class="form-label fw-semibold">@L["CreateTrip_PickupPoints"]</label>
                @for (var i = 0; i < _pickupPoints.Count; i++)
                {
                    var index = i;
                    <div class="mb-2">
                        <div class="d-flex align-items-center gap-2 mb-1">
                            <span class="badge bg-secondary">@(index + 1)</span>
                            <button type="button" class="btn btn-outline-danger btn-sm ms-auto"
                                    @onclick="() => _pickupPoints.RemoveAt(index)">@L["CreateTrip_Remove"]</button>
                        </div>
                        <input class="form-control" value="@_pickupPoints[index]"
                               @oninput="e => _pickupPoints[index] = e.Value?.ToString() ?? string.Empty"
                               placeholder="@L["CreateTrip_PickupHint"]" />
                    </div>
                }
                <button type="button" class="btn btn-outline-secondary btn-sm"
                        @onclick="AddPickupPoint">@L["CreateTrip_AddPickup"]</button>
                @if (_pickupPointsError is not null)
                {
                    <div class="text-danger small mt-1">@_pickupPointsError</div>
                }
            </div>

            @if (_error is not null)
            {
                <div class="alert alert-danger">@_error</div>
            }

            <div class="d-flex gap-2 mt-4">
                <button type="submit" class="btn btn-primary" disabled="@_submitting">
                    @(_submitting ? L["CreateTrip_Posting"].Value : L["CreateTrip_Post"].Value)
                </button>
                <a href="/my-trips" class="btn btn-outline-secondary">@L["CreateTrip_Cancel"]</a>
            </div>
        </EditForm>
            </div>
        </div>
    }
</div>

@code {
    private readonly CreateTripModel _model = new();
    private readonly List<string> _pickupPoints = [];
    private bool _submitting;
    private string? _error;
    private string? _pickupPointsError;

    private void AddPickupPoint() => _pickupPoints.Add(string.Empty);

    private async Task HandleSubmit()
    {
        _submitting = true;
        _error = null;

        var validPickupPoints = _pickupPoints.Where(p => !string.IsNullOrWhiteSpace(p)).ToList();
        if (validPickupPoints.Count == 0)
        {
            _pickupPointsError = L["CreateTrip_PickupRequired"];
            _submitting = false;
            return;
        }
        _pickupPointsError = null;

        var result = await TripsClient.CreateTripAsync(new
        {
            _model.From,
            _model.To,
            _model.TotalSeats,
            _model.PricePerSeat,
            DepartureTime = _model.DepartureTime,
            _model.Note,
            _model.PaymentMethod,
            _model.Currency,
            _model.NumberPlate,
            PickupPoints = validPickupPoints,
            DriverFullName = UserSession.FullName
        });

        if (result.Success)
            Nav.NavigateTo($"/trips/{result.Trip!.Id}");
        else
            _error = result.Error;

        _submitting = false;
    }

    private class CreateTripModel
    {
        [Required(ErrorMessage = "From is required.")]
        public string From { get; set; } = string.Empty;

        [Required(ErrorMessage = "To is required.")]
        public string To { get; set; } = string.Empty;

        [Range(1, 50, ErrorMessage = "Seats must be between 1 and 50.")]
        public int TotalSeats { get; set; } = 1;

        [Range(1, 99999, ErrorMessage = "Price per seat must be at least 1.")]
        public decimal PricePerSeat { get; set; }

        public string Currency { get; set; } = "DKK";

        [Required(ErrorMessage = "Departure date and time is required.")]
        public DateTime? DepartureTime { get; set; }

        [Required(ErrorMessage = "Number plate is required.")]
        public string? NumberPlate { get; set; }

        public string? Note { get; set; }
        public string? PaymentMethod { get; set; }
    }
}
