@page "/verify-code"
@rendermode InteractiveServer
@using GoCheaper.Web.Services
@using Microsoft.Extensions.Caching.Memory
@inject IdentityApiClient IdentityApi
@inject IMemoryCache Cache
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L

<PageTitle>Verify Code - GoCheaper</PageTitle>

<div class="container py-5">
    <div class="row justify-content-center">
        <div class="col-md-6 col-lg-5">
            <div class="card shadow-sm">
                <div class="card-header bg-primary text-white py-3">
                    <h4 class="mb-0">@L["VerifyCode_Title"]</h4>
                    <small class="opacity-75">
                        @string.Format(L["VerifyCode_Subtitle"], Email)
                    </small>
                </div>
                <div class="card-body p-4">

                    @if (!string.IsNullOrEmpty(apiError))
                    {
                        <div class="alert alert-danger">@apiError</div>
                    }

                    <p class="text-muted small">@L["VerifyCode_Expires"]</p>

                    <div class="mb-4">
                        <label class="form-label fw-semibold">@L["VerifyCode_Label"]</label>
                        <input @bind="code" @bind:event="oninput"
                               class="form-control form-control-lg text-center fw-bold fs-4 letter-spacing-wide"
                               type="text" inputmode="numeric" pattern="[0-9]*"
                               maxlength="6" placeholder="000000"
                               autocomplete="one-time-code" />
                    </div>

                    <button class="btn btn-primary btn-lg w-100"
                            @onclick="HandleVerify"
                            disabled="@(isLoading || code.Length != 6)">
                        @if (isLoading)
                        {
                            <span class="spinner-border spinner-border-sm me-2" role="status" aria-hidden="true"></span>
                            <span>@L["VerifyCode_Verifying"]</span>
                        }
                        else
                        {
                            <span>@L["VerifyCode_VerifyBtn"]</span>
                        }
                    </button>

                    <hr class="my-4" />
                    <p class="text-center text-muted small mb-0">
                        @L["VerifyCode_DidntReceive"]
                        <a href="/login">@L["VerifyCode_RequestNew"]</a>
                    </p>
                </div>
            </div>
        </div>
    </div>
</div>

@code {
    [SupplyParameterFromQuery(Name = "email")]     public string? Email     { get; set; }
    [SupplyParameterFromQuery(Name = "returnUrl")] public string? ReturnUrl { get; set; }

    private string code     = string.Empty;
    private string? apiError;
    private bool isLoading;

    private async Task HandleVerify()
    {
        if (string.IsNullOrWhiteSpace(Email) || code.Length != 6) return;

        apiError  = null;
        isLoading = true;
        try
        {
            var result = await IdentityApi.VerifyAuthCodeAsync(Email, code);
            if (result.Success && result.Tokens is not null)
            {
                var key = Guid.NewGuid().ToString("N");
                Cache.Set(key, result.Tokens, TimeSpan.FromSeconds(30));

                var destination = string.IsNullOrEmpty(ReturnUrl) ? "/" : ReturnUrl;
                Nav.NavigateTo(
                    $"/auth/complete?key={key}&returnUrl={Uri.EscapeDataString(destination)}",
                    forceLoad: true);
            }
            else
            {
                apiError = result.Error ?? "Invalid or expired code.";
            }
        }
        finally
        {
            isLoading = false;
        }
    }
}
