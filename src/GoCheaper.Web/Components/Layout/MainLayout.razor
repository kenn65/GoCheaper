@inherits LayoutComponentBase
@inject IStringLocalizer<SharedResources> L

<NavMenu />

<div class="container-fluid py-4" style="flex:1">
    @Body
</div>

<footer class="border-top mt-4 py-3 text-center text-muted small">
    <div class="container">
        <a href="/privacy-policy" class="me-3">@L["Footer_PrivacyPolicy"]</a>
        <a href="https://github.com/kenn65/GoCheaper" target="_blank" rel="noopener" class="me-3">@L["Footer_OpenSource"]</a>
        <span>&copy; @DateTime.Now.Year GoCheaper &mdash; @L["Footer_NonProfit"]</span>
    </div>
</footer>

<div id="blazor-error-ui" data-nosnippet>
    @L["Error_Unhandled"]
    <a href="." class="reload">@L["Error_Reload"]</a>
    <span class="dismiss">&#x2715;</span>
</div>
