@using GoCheaper.Web.Services
@inject UserSession UserSession
@inject AuthCookieService AuthCookies
@inject NavigationManager Nav
@inject IStringLocalizer<SharedResources> L
@implements IDisposable

<nav class="navbar navbar-expand-sm navbar-dark bg-primary px-3 shadow-sm">
    <a class="navbar-brand fw-bold" href="/">GoCheaper</a>

    <button class="navbar-toggler" type="button" data-bs-toggle="collapse"
            data-bs-target="#navContent" aria-controls="navContent"
            aria-expanded="false" aria-label="Toggle navigation">
        <span class="navbar-toggler-icon"></span>
    </button>

    <div class="collapse navbar-collapse" id="navContent">
        <ul class="navbar-nav me-auto">
            @if (UserSession.IsLoggedIn && UserSession.IsProfileComplete)
            {
                <li class="nav-item">
                    <NavLink class="nav-link" href="/my-profile" Match="NavLinkMatch.Prefix">
                        @L["Nav_MyProfile"]
                    </NavLink>
                </li>
                @if (UserSession.IsDriver)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/my-trips" Match="NavLinkMatch.Prefix">
                            @L["Nav_MyTrips"]
                        </NavLink>
                    </li>
                }
                @if (UserSession.IsPassenger)
                {
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/browse-trips" Match="NavLinkMatch.Prefix">
                            @L["Nav_BrowseTrips"]
                        </NavLink>
                    </li>
                    <li class="nav-item">
                        <NavLink class="nav-link" href="/my-booked-trips" Match="NavLinkMatch.Prefix">
                            @L["Nav_MyBookedTrips"]
                        </NavLink>
                    </li>
                }
            }
        </ul>

        <ul class="navbar-nav ms-auto align-items-center gap-2">
            @if (UserSession.IsLoggedIn)
            {
                <li class="nav-item">
                    <span class="text-white opacity-75 small">
                        @(string.IsNullOrWhiteSpace(UserSession.FullName) ? UserSession.Email : UserSession.FullName)
                    </span>
                </li>
                <li class="nav-item">
                    <button class="btn btn-outline-light btn-sm" @onclick="HandleSignOut">
                        @L["Nav_SignOut"]
                    </button>
                </li>
            }
            else
            {
                <li class="nav-item">
                    <NavLink class="btn btn-outline-light btn-sm" href="/login" Match="NavLinkMatch.Prefix">
                        @L["Nav_SignIn"]
                    </NavLink>
                </li>
            }

            <!-- Language switcher -->
            <li class="nav-item dropdown">
                <a class="nav-link dropdown-toggle text-white p-0" href="#" role="button"
                   data-bs-toggle="dropdown" aria-expanded="false" style="font-size:0.85rem;">
                    🌐
                </a>
                <ul class="dropdown-menu dropdown-menu-end">
                    <li><a class="dropdown-item" href="@CultureUrl("en")">English</a></li>
                    <li><a class="dropdown-item" href="@CultureUrl("da")">Dansk</a></li>
                    <li><a class="dropdown-item" href="@CultureUrl("nb")">Norsk</a></li>
                    <li><a class="dropdown-item" href="@CultureUrl("sv")">Svenska</a></li>
                </ul>
            </li>
        </ul>
    </div>
</nav>

@code {
    protected override void OnInitialized()
        => UserSession.OnChange += OnSessionChanged;

    private void OnSessionChanged()
        => InvokeAsync(StateHasChanged);

    private async Task HandleSignOut()
    {
        await AuthCookies.SignOutAsync();
        Nav.NavigateTo("/", forceLoad: true);
    }

    private string CultureUrl(string culture)
    {
        var currentPath = new Uri(Nav.Uri).AbsolutePath;
        return $"/culture?culture={culture}&redirectUri={Uri.EscapeDataString(currentPath)}";
    }

    public void Dispose()
        => UserSession.OnChange -= OnSessionChanged;
}
